npc_name = "Elder Vorn"
dialogue_lines = [
	"Young traveler, you made it through Cairnwood Forest!",
	"Alas, news has reached us of the Master's demise at the hands of the Corruptor...",
	"The darkness rises again. Only the legendary Mageblade can pierce the corrupt barrier.",
	"The blade was shattered into four Iselon Shards scattered across the realm.",
	"Head east to the Crossroads. The ancient crypt lies beyond."
]
