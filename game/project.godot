; Engine configuration file.
; Sourced from authentic Swordigo baseline and configured for Godot 4.4.

config_version=5

[application]

config/name="Swordigo V2: Extended Edition"
config/description="Faithful reproduction of classic Swordigo with additive sequel expansion."
config/version="2.0.0"
run/main_scene="res://ui/main_menu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://systems/game_manager.gd"
Inventory="*res://systems/inventory.gd"
QuestManager="*res://systems/quest_manager.gd"
AudioManager="*res://systems/audio_manager.gd"
SaveSystem="*res://systems/save_system.gd"
SceneTransition="*res://ui/scene_transition.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

